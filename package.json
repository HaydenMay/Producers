{
  "name": "producers-balance-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Producers (working game name): headless deterministic balance/simulation harness. Not the game. Canonical design: docs/DESIGN_LEDGER.md.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/cli/main.ts sim",
    "batch": "tsx src/cli/main.ts batch",
    "compare": "tsx src/cli/main.ts compare",
    "scenarios": "tsx src/cli/main.ts scenarios",
    "dev": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "replay": "tsx src/cli/main.ts replay",
    "experiment": "tsx src/cli/main.ts experiment",
    "legs": "tsx src/cli/main.ts legs",
    "selffund": "tsx src/cli/main.ts selffund",
    "early": "tsx src/cli/main.ts early",
    "eras": "tsx src/cli/main.ts eras",
    "counterfactuals": "tsx src/cli/main.ts counterfactuals",
    "economy:smoke": "tsc --noEmit && vitest run tests/integration/gate4.test.ts && tsx scripts/economy.ts smoke",
    "economy:compare": "tsx scripts/economy.ts compare",
    "economy:gate": "tsx scripts/economy.ts gate",
    "stars:smoke": "tsc --noEmit && vitest run tests/integration/stars.test.ts && tsx scripts/stars.ts",
    "quality:smoke": "tsc --noEmit && vitest run tests/integration/gate4q.test.ts && tsx scripts/quality.ts",
    "quality:compare": "tsx scripts/quality.ts --seeds 16 --years 10 --out reports/gate4q/compare --quiet",
    "ledger:check": "tsx scripts/ledger-check.ts && tsx scripts/register.ts --check",
    "dev:game": "vite --config vite.game.config.ts",
    "build:game": "vite build --config vite.game.config.ts",
    "preview:game": "vite preview --config vite.game.config.ts",
    "dev:characters": "vite --config vite.character-lab.config.ts",
    "build:characters": "vite build --config vite.character-lab.config.ts",
    "preview:characters": "vite preview --config vite.character-lab.config.ts",
    "build:pages": "npm run build:characters -- --outDir ../../dist-pages && npm run build:game -- --base /Producers/studio/ --outDir ../../dist-pages/studio && node scripts/check-pages-build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
