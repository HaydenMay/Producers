{
  "_label": "Gate 3 follow-up stress matrix. Every variant starts from config/gate3.json (firing + money-aware renewal ON for sensible policies; renewal-franchise stays stubborn). All numbers are TEST ASSUMPTIONS, not proposals to lock.",
  "strategies": [
    "tv-first",
    "renewal-franchise",
    "traditional-holdout",
    "mixed",
    "streaming-pivot",
    "balanced"
  ],
  "orderStrategies": [
    "tv-first",
    "renewal-franchise"
  ],
  "horizons": [
    10,
    15,
    25
  ],
  "variants": [
    {
      "name": "A0_noFiring",
      "note": "Gate 3 policies before the follow-up: no firing, renewal by score only (reference for firing before/after)",
      "overrides": {
        "agents": {
          "useFiring": false,
          "economicRenewal": false
        }
      }
    },
    {
      "name": "A_control",
      "note": "follow-up control: firing + money-aware renewal; both fatigue experiments off; 35% review-fatigue cap unchanged",
      "overrides": {}
    },
    {
      "name": "B_mildViewer",
      "note": "+ mild returning-viewer fatigue (seasons basis)",
      "overrides": {
        "tv": {
          "viewerFatigue": {
            "enabled": true,
            "basis": "seasons",
            "onset": 4,
            "perStep": 0.02,
            "exponent": 1.2,
            "max": 0.35
          }
        }
      }
    },
    {
      "name": "B_ep_mildViewer",
      "note": "same strength on an EPISODE-exposure basis (10 episodes = 1 step)",
      "overrides": {
        "tv": {
          "viewerFatigue": {
            "enabled": true,
            "basis": "episodes",
            "episodesPerStep": 10,
            "onset": 4,
            "perStep": 0.02,
            "exponent": 1.2,
            "max": 0.35
          }
        }
      }
    },
    {
      "name": "C_mildViewer_lessReview",
      "note": "mild viewer fatigue + reduced review fatigue (cap 35% -> 20%, rate 1.2% -> 0.8%)",
      "overrides": {
        "tv": {
          "viewerFatigue": {
            "enabled": true,
            "basis": "seasons",
            "onset": 4,
            "perStep": 0.02,
            "exponent": 1.2,
            "max": 0.35
          },
          "fatigue": {
            "perSeason": 0.008,
            "max": 0.2
          }
        }
      }
    },
    {
      "name": "D_strongViewer",
      "note": "stronger viewer fatigue (optional variant)",
      "overrides": {
        "tv": {
          "viewerFatigue": {
            "enabled": true,
            "basis": "seasons",
            "onset": 2,
            "perStep": 0.04,
            "exponent": 1.3,
            "max": 0.6
          }
        }
      }
    },
    {
      "name": "A_events",
      "note": "control + rare creative breakthroughs (2% per stage check, max 1 per production)",
      "overrides": {
        "events": {
          "breakthrough": {
            "enabled": true
          }
        }
      }
    },
    {
      "name": "C_events",
      "note": "C + rare creative breakthroughs",
      "overrides": {
        "tv": {
          "viewerFatigue": {
            "enabled": true,
            "basis": "seasons",
            "onset": 4,
            "perStep": 0.02,
            "exponent": 1.2,
            "max": 0.35
          },
          "fatigue": {
            "perSeason": 0.008,
            "max": 0.2
          }
        },
        "events": {
          "breakthrough": {
            "enabled": true
          }
        }
      }
    },
    {
      "name": "C_comboD",
      "note": "C + the Gate 2.6 combo_D critic/audience curve (interaction check only; defaults unchanged)",
      "overrides": {
        "tv": {
          "viewerFatigue": {
            "enabled": true,
            "basis": "seasons",
            "onset": 4,
            "perStep": 0.02,
            "exponent": 1.2,
            "max": 0.35
          },
          "fatigue": {
            "perSeason": 0.008,
            "max": 0.2
          }
        },
        "expectations": {
          "critics": {
            "enabled": true,
            "generationYears": 6,
            "toughnessPerGeneration": 0.08,
            "maxToughness": 0.12
          },
          "audience": {
            "enabled": true,
            "eraYears": 10,
            "toughnessPerEra": 0.02,
            "maxToughness": 0.06
          }
        }
      }
    }
  ],
  "orderVariants": [
    {
      "name": "A_control@5ep",
      "base": "A_control",
      "overrides": {
