    },
    {
      "name": "B_mildViewer@5ep",
      "base": "B_mildViewer",
      "overrides": {
        "agents": {
          "tvOrderPreference": 5
        }
      }
    },
    {
      "name": "B_ep_mildViewer@5ep",
      "base": "B_ep_mildViewer",
      "overrides": {
        "agents": {
          "tvOrderPreference": 5
        }
      }
    },
    {
      "name": "C_mildViewer_lessReview@5ep",
      "base": "C_mildViewer_lessReview",
      "overrides": {
        "agents": {
          "tvOrderPreference": 5
        }
      }
    },
    {
      "name": "A_control@10ep",
      "base": "A_control",
      "overrides": {
        "agents": {
          "tvOrderPreference": 10
        }
      }
    },
    {
      "name": "B_ep_mildViewer@10ep",
      "base": "B_ep_mildViewer",
      "overrides": {
        "agents": {
          "tvOrderPreference": 10
        }
      }
    },
    {
      "name": "A_eventsBig",
      "base": "A_events",
      "note": "sensitivity: breakthroughs 5x bigger (bonusShare 0.6 -> 3.0), same 2% chance",
      "overrides": {
        "events": {
          "breakthrough": {
            "bonusShare": 3.0
          }
        }
      }
    },
    {
      "name": "D_strongViewer_premiere",
      "base": "D_strongViewer",
      "note": "sensitivity: strong viewer fatigue ALSO scales the episode-1 premiere share (appliesTo returningAndPremiere)",
      "overrides": {
        "tv": {
          "viewerFatigue": {
            "appliesTo": "returningAndPremiere"
          }
        }
